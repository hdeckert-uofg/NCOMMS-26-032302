print(startText);

usedExpt = new String("LUC");
global.ExptTime = userTl * 12 - userZt * 0.5; //for luciferase every 2 hours
global.nrFrames = ExptTime;

//Time conversion
global.TimeA = 3600000 - 335000;//Hard-wired one hour imaging here, taking pauses and exposure time off

mm.scripter().message("Configuration complete: Lights set to " + usedColour + "\n" + "Expt type : " + usedExpt + "\n" + "Flipper is " + usedFlipper); //Config confirmation

//Begin acquisition
mm.scripter().message("ZT at start: " + (int) userZt + "\n" + "Taking " + (int) ExptTime + " frames in total");
if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down

mmc.setProperty("LUMO", "Gain", "3");//High sensitivity mode
