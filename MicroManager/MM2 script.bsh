global.nrFramesBi = nrFramesB;
global.nrFramesCi = (nrFramesC / userTimeA);
global.repeatLoopi = repeatLoop;
global.pauseAi = pauseA;
global.pauseAims = pauseAi * 60000;

global.dayCal = nrFramesAi * userTimeA;
global.nightCal = nrFramesBi * userTimeB;
global.loopCal = repeatLoop + 1;
String dayCalu = new String ();
String nightCalu = new String ();
String loopCalu = new String ();
String pauseCalu = new String ();
dayCalu += dayCal;
nightCalu += nightCal;
loopCalu += loopCal;
pauseCal = (int) pauseA;
pauseCalu += pauseCal;

//If numbers are too high, cancel
if (RedVoltsA > 100){
gui.showMessage("Red lights are set too high in day- please change");//Logic gate for exposure
return;}
if (BlueVoltsA > 100){
gui.showMessage("Blue lights are set too high in day- please change");//Logic gate for exposure
return;}

if (RedVoltsB > 100){
gui.showMessage("Red lights are set too high in day- please change");//Logic gate for exposure
return;}
if (BlueVoltsB > 100){
gui.showMessage("Blue lights are set too high in day- please change");//Logic gate for exposure
return;}

if (RedVoltsC > 100){
gui.showMessage("Red lights are set too high in day- please change");//Logic gate for exposure
return;}
if (BlueVoltsC > 100){
gui.showMessage("Blue lights are set too high in day- please change");//Logic gate for exposure
return;}

//Confirmation text
gh = new ij.gui.GenericDialog("LD-LL Cycles");
gh.addStringField("Day length (Hrs, Confirmation only): ", dayCalu, 4);
gh.addStringField("Night length (Hrs, Confirmation only): ", nightCalu, 4);
gh.addStringField("# of days (Confirmation only): ", loopCalu, 4);
gh.addStringField("First imaging loop in (Mins, Confirmation only): ", pauseCalu, 4);
gh.showDialog();
if (gh.wasCanceled())
	return;

//Time conversion
global.TimeA = userTimeA * 3600000;
global.TimeB= userTimeB * 3600000;

global.TimeAm = TimeA - 723000;//30min 2 second image capture- no zeros off here
global.TimeBm = TimeB - 723000;//30min 2 second image capture- no zeros off here

//First Day
global.firstDiel = nrFramesAi - (userZt / userTimeA);
if (pauseCal == 0){
	global.firstDiel = (int) firstDiel;}
else {global.firstDiel = firstDiel - 1;}
	global.firstNight = nrFramesBi;
	global.firstDay = firstDiel + firstNight;
	print("First diurnal: " + firstDiel + " images");
	print("First night: " + firstNight + " images");
	print("First day: " + firstDay + " images");

logicDiel = dayCal - userZt;//Logic gate for day length
if (logicDiel <= 1){
	mm.scripter().message("Cannot start after ZT11");
	return;}

//Flipper picker- LD-LL loop
if (userFlipper == "Yes"){
	flipper = 1830;
	usedFlipper = new String("active");}
if (userFlipper == "No") {
	flipper = 1100;
	usedFlipper = new String("off");}

//Starting timestamp
public void refreshGUI();
mm.scripter().clearMessageWindow();
String startText = new String("Expt started at: ");
Calendar cal = Calendar.getInstance();
startText += cal.getTime();
print(startText);

//Start imaging

//Redefine parameters
global.nrFrames = ((firstDay + ((nrFramesAi + nrFramesBi) * repeatLoopi)) + nrFramesCi); //Number of images
global.globalCount = firstDay;
global.colourAloop = nrFramesAi + globalCount;
global.colourBloop = colourAloop + nrFramesBi;

//Colour picker
mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set red growth LEDs to off
mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0"); //Set blue growth LEDs to off
mmc.setProperty("Arduino32-DAC/400nm", "Volts", "0"); //Turn off imaging LEDs
mmc.setProperty("Arduino32-DAC/460nm", "Volts", "0"); //Turn off imaging LEDs

public void refreshGUI();
repeatLoopText = repeatLoop + 1;
String diffText = new String("Configuration complete: Lights set to " + usedColourA + " for " + (int) userTimeA + " hrs x " + nrFramesAi + " then " + usedColourB + " for " + (int) userTimeB + " hrs x " + nrFramesBi + " for " + (int) repeatLoopText + " days, then " + (int) nrFramesC + " hours in " + usedColourC + "\n" + "Expt type : LUC" + "\n"); //Config confirmation
print(diffText);

//Setup save file
saveLocation += userFile;
Datastore store = mm.data().createRAMDatastore();
mm.displays().createDisplay(store);

//Image acquisition loop
mm.scripter().message("Waiting to begin program");
mmc.sleep(2000); //wait before entering loop
if (userFlipper == "Yes"){
	mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
mmc.sleep(2000); //wait before turning on lights
mm.scripter().message(usedColourA + " LEDs on");
mm.scripter().message("Pausing for " + pauseAi + " mins before entering imaging loop");
mmc.sleep(pauseAims);
	
//First day imaging
	for (k=0; k < firstDiel; k++) {
		print(startText);
		print(diffText);
		Calendar cal = Calendar.getInstance();
		loopTime = cal.getTime();
		x = k+1;
		mm.scripter().message("Loop " + x + " of " + nrFrames + " at:" + "\n" + loopTime);
      mmc.setProperty("LUMO", "Gain", "3");//High sensitivity mode
      mmc.setProperty("LUMO", "PP  1   ENABLED", "Yes");//Turn off reduce hgh pixels
      mmc.setExposure(300000);//Set exposure for luciferase (15min)
      if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
      mmc.setProperty("FW", "State", "4");//Move FW to 685nm
		mmc.deviceBusy("FW"); //Safety call to wait for filterwheel to move
      mmc.setProperty("Arduino32-DAC/Red", "Volts", RedVoltsA); //Set red growth LEDs on
	  mmc.setProperty("Arduino32-DAC/Blue", "Volts", BlueVoltsA); 
		mm.scripter().message(usedColourA + " LEDs on for " + userTimeA + " hrs");
		mmc.sleep(TimeAm);
		//Acquisition loop
		mmc.setShutterOpen(false); //Turn off LEDs
		mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set red growth LEDs on
	  	mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0"); 
		mm.scripter().message("Growth LEDs off");
		mm.scripter().message("Pausing before imaging");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1100);}//Moves flipper up
		mmc.sleep(30000); //Wait 2 min
		mm.scripter().message("Luciferase imaging in progress");
		image = mm.live().snap(false).get(0);
		Coords.CoordsBuilder builder = mm.data().getCoordsBuilder();
		builder = builder.time(k).channel(0);
		image = image.copyAtCoords(builder.build());
		store.putImage(image);
		mm.scripter().message("Image " + x + " complete");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
		mmc.sleep(2000); //Pause after exposures (currently 2sec)
		mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish
		//Acquisition loop ends
		global.l = k + 1;
   		}
	for (l=l; l < firstDay; l++) {
		print(startText);
		print(diffText);
		Calendar cal = Calendar.getInstance();
		loopTime = cal.getTime();
		x = l+1;
		mm.scripter().message("Loop " + x + " of " + nrFrames + " at:" + "\n" + loopTime);
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
		mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set growth LEDs off
		mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
		mmc.sleep(1000);
		mmc.setProperty("Arduino32-DAC/Red", "Volts", RedVoltsB); //Set growth LEDs on
		mmc.setProperty("Arduino32-DAC/Blue", "Volts", BlueVoltsB);
		mm.scripter().message(usedColourB + " LEDs on for " + userTimeB + " hrs");
		mmc.sleep(TimeBm);

//Acquisition loop
		mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set growth LEDs off
		mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
		mm.scripter().message("Growth LEDs off");
		mm.scripter().message("Pausing before imaging");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1100);}//Moves flipper up
		mmc.sleep(30000);
		mm.scripter().message("Luciferase imaging in progress");
		image = mm.live().snap(false).get(0);
		Coords.CoordsBuilder builder = mm.data().getCoordsBuilder();
		builder = builder.time(l).channel(0);
		image = image.copyAtCoords(builder.build());
		store.putImage(image);
		mm.scripter().message("Image " + x + " complete");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
		mmc.sleep(2000); //Pause after exposures (currently 2sec)
		mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish
		//Acquisition loop ends
   		}
//Entering into Diurnal loop
	for (countLoop=0; countLoop < repeatLoopi; countLoop++) {

	for (i=globalCount; i < colourAloop; i++) {
		i = (int) i;
		print(startText);
		print(diffText);
		Calendar cal = Calendar.getInstance();
		loopTime = cal.getTime();
		x = i+1;
		mm.scripter().message("Loop " + x + " of " + nrFrames + " at:" + "\n" + loopTime + " - Daytime");
      if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
      mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set growth LEDs off
		mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
		mmc.sleep(1000);
		mmc.setProperty("Arduino32-DAC/Red", "Volts", RedVoltsA); //Set growth LEDs on
		mmc.setProperty("Arduino32-DAC/Blue", "Volts", BlueVoltsA);
		mm.scripter().message(usedColourA + " LEDs on for " + userTimeA + " hrs");
		mmc.sleep(TimeAm);
		
//Acquisition loop
		mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set growth LEDs off
		mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
		mm.scripter().message("Growth LEDs off");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1110);}//Moves flipper up
		mm.scripter().message("Pausing before imaging");
		mmc.sleep(30000); //Wait 2 min
		mm.scripter().message("Luciferase imaging in progress");
		image = mm.live().snap(false).get(0);
		Coords.CoordsBuilder builder = mm.data().getCoordsBuilder();
		builder = builder.time(i).channel(0);
		image = image.copyAtCoords(builder.build());
		store.putImage(image);
		mm.scripter().message("Image " + x + " complete");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
		mmc.sleep(2000); //Pause after exposures (currently 2sec)
		mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish
		global.j = i + 1;
		if (j ==colourAloop){ 
		global.colourBloop = colourAloop + nrFramesBi;}
		//Acquisition loop ends
   		}
	for (j=j; j < colourBloop; j++) {
		j = (int) j;
		print(startText);
		print(diffText);
		Calendar cal = Calendar.getInstance();
		loopTime = cal.getTime();
		x = j+1;
		mm.scripter().message("Loop " + x + " of " + nrFrames + " at:" + "\n" + loopTime + " - Night time");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
      mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set growth LEDs off
	  mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
	  	mmc.sleep(1000);
		mmc.setProperty("Arduino32-DAC/Red", "Volts", RedVoltsB); //Set growth LEDs on
		mmc.setProperty("Arduino32-DAC/Blue", "Volts", BlueVoltsB);
		mm.scripter().message(usedColourB + " LEDs on for " + userTimeB + " hrs");
		mmc.sleep(TimeBm);
		
//Acquisition loop
		mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set growth LEDs off
	 	mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
		mm.scripter().message("Growth LEDs off");
		mm.scripter().message("Pausing before imaging");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1100);}//Moves flipper up
		mmc.sleep(30000);
		mm.scripter().message("Luciferase imaging in progress");
		image = mm.live().snap(false).get(0);
		Coords.CoordsBuilder builder = mm.data().getCoordsBuilder();
		builder = builder.time(j).channel(0);
		image = image.copyAtCoords(builder.build());
		store.putImage(image);
		mm.scripter().message("Image " + x + " complete");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
		mmc.sleep(2000); //Pause after exposures (currently 2sec)
		mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish
		//Acquisition loop ends
	print("j = " + j);
	global.m = j + 1;
	if (m == colourBloop){
		global.colourAloop = colourBloop + nrFramesAi;}
   		}
if (countLoop < repeatLoopi){
	global.globalCount = m;}
	}//End daily loop
//Entering into constant light loop
	if (repeatLoopi == 0){
		global.m = globalCount;}
	for (m=m; m < nrFrames; m++) {
		m = (int) m;
		print(startText);
		print(diffText);
		Calendar cal = Calendar.getInstance();
		loopTime = cal.getTime();
		y = m+1;
		mm.scripter().message("Loop " + y + " of " + nrFrames + " at:" + "\n" + loopTime + " - Constant light");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
      mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set growth LEDs off
	  mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
	  	mmc.sleep(1000);
		mmc.setProperty("Arduino32-DAC/Red", "Volts", RedVoltsC); //Set growth LEDs on
		mmc.setProperty("Arduino32-DAC/Blue", "Volts", BlueVoltsC);
		mm.scripter().message(usedColourC + " LEDs on for " + userTimeA + " hrs");
		mmc.sleep(TimeAm);
		
//Acquisition loop
		mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set growth LEDs off
	  	mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
		mm.scripter().message("Growth LEDs off");
		mm.scripter().message("Pausing before imaging");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1100);}//Moves flipper up
		mmc.sleep(30000);
		mm.scripter().message("Luciferase imaging in progress");
		image = mm.live().snap(false).get(0);
		Coords.CoordsBuilder builder = mm.data().getCoordsBuilder();
		builder = builder.time(m).channel(0);
		image = image.copyAtCoords(builder.build());
		store.putImage(image);
		mm.scripter().message("Image " + y + " complete");
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
		mmc.sleep(2000); //Pause after exposures (currently 2sec)
		mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish
		//Acquisition loop ends
	}

//Save data
store.save(Datastore.SaveMode.MULTIPAGE_TIFF, saveLocation);
store.freeze();
mm.scripter().message("Imaging complete");
	
   }//End Constant condition loop
//Contant light, luciferase
if (userMode == "LUC LL"){
