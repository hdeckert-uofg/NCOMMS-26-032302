public void refreshGUI();
mm.scripter().message("LEDs on, waiting to enter loop");
mmc.sleep(5000); //wait before entering loop
nrFramesZ = (int) nrFrames;

//Setup save file
saveLocation += userFile;
Datastore store = mm.data().createRAMDatastore();

mm.displays().createDisplay(store);

	for (m=0; m < nrFrames; m++) {
		m = (int) m;
		print(startText);
		Calendar cal = Calendar.getInstance();
		loopTime = cal.getTime();
		y = m+1;
		mm.scripter().message("Loop " + y + " of " + nrFrames + " at:" + "\n" + loopTime + " - Constant light");
      mmc.setProperty("Arduino32-DAC/Red", "Volts", RedVolts); //Set red growth LEDs to off
	  mmc.setProperty("Arduino32-DAC/Blue", "Volts", BlueVolts); //Set blue growth LEDs to off
		mm.scripter().message(usedColour + " LEDs on for " + userTime + " hrs");
		mmc.sleep(TimeA);

		
		//Acquisition loop
		mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set red growth LEDs to off
		mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0"); //Set blue growth LEDs to off
		mm.scripter().message("Growth LEDs off");
		mmc.sleep(2000); //Pause before exposure (currently 5sec)
		if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1100);}//Moves flipper up
		mm.scripter().message("Pausing before luciferase imaging");
		mmc.sleep(30000); //Wait 2 min
		mm.scripter().message("Luciferase imaging in progress");


	image = mm.live().snap(false).get(0);
	Coords.CoordsBuilder builder = mm.data().getCoordsBuilder();
	builder = builder.time(m).channel(0);
	image = image.copyAtCoords(builder.build());
	store.putImage(image);
	mm.scripter().message("Image " + y + " complete");
	if (userFlipper == "Yes"){mmc.setProperty("MaestroServo", "Position", 1830);}//Moves flipper down
	mmc.sleep(3000); //Pause after exposures (currently 2sec)
	mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish
	}
		//Acquisition loop ends
//Save data
store.save(Datastore.SaveMode.MULTIPAGE_TIFF, saveLocation);
store.freeze();
mm.scripter().message("Imaging complete");		
   		}//End constant loop

//Reset hardware
mmc.sleep(5000);
mmc.setProperty("Arduino32-DAC/460nm", "Volts", "0"); //Turn all lights off, redundant but safe
mmc.setProperty("Arduino32-DAC/400nm", "Volts", "0");
mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
mmc.setProperty("Arduino32-DAC/Red", "Volts", "0");
mm.scripter().message("LEDs off after imaging");
mmc.setProperty("FW", "State", "0");//Move filter into 515nm
mmc.deviceBusy("FW"); //Safety call to wait for filterwheel to move
mmc.setExposure(20); // Resets camera exposure (in ms)
mmc.setProperty("LUMO", "Gain", "2");//Mid sensitivity mode
mmc.setProperty("LUMO", "PP  1   ENABLED", "No");//Turn off high pixel reduction
public void refreshGUI();

//log settings
FileWriter fstream = new FileWriter("C:\\LUMOData\\log.txt", true);
BufferedWriter out = new BufferedWriter(fstream);
out.write(usedLUMO + "," + userFile + "," + usedColourA + "," + usedFlipper + "," + userZt);
out.write(System.getProperty("line.separator"));
out.close();
fstream.close();
mm.scripter().message("Program complete");
return;