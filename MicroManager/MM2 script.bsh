//Custom exposure and delays

if (delayUserUnits == "min"){
	global.delayUnits = 60000;}
else {delayUnits = 1000;}
if (expUserUnits == "min"){
	global.expUnits = 60000;}
else {expUnits = 1000;}
global.usedDelay = userDelay * delayUnits;
global.usedExpose = userExpose * expUnits;
if (usedDelay <= 99){
	mm.scripter().message("Delay must be greater than 100 ms!");
	return;}
if (usedExpose <= 0){
	mm.scripter().message("Exposure must be greater than 0!");
return;}
}

//Starting timestamp
