//import mmcorej.TaggedImage;

//Set parameters
String saveLocation = "C:\\LUMOData\\";
String [] mode = {"GFP", "LUC LD-LL", "LUC LL"};
String [] expt = {"GFP quick image", "GFP LD-LL", "GFP LL", "GFP LL sub 30 pulse"};
String [] colour = {"Off", "Red", "Blue", "Red+Blue"};
String [] flip = {"No", "Yes"};
String [] units = {"min", "secs"};
String [] channels = {"400nm","460nm", "Luciferase","Autofluo"};
Color[] colors = {Color.GREEN ,Color.RED, Color.WHITE};

//Start dialogue inputs
ga = new ij.gui.GenericDialog("LUMO Imaging System");
ga.addStringField("LUMOB-", "000", 0);
ga.addChoice("Expt type : ", mode, mode[0]);
ga.showDialog();
if (ga.wasCanceled())
	return;
userLUMO = ga.getNextString();
String userFile = "LUMOB-" + userLUMO; 
String file2 = "-CaF"; 
userMode = ga.getNextChoice();

if (userMode == "GFP"){

gc = new ij.gui.GenericDialog("LUMO Imaging System");
gc.addChoice("Expt type : ", expt, expt[1]);
gc.addCheckbox("Pause after growth lights off? ",false);
gc.addCheckbox("Luciferase imaging?",false);
gc.addNumericField("Exposure time (s) : ", 2, 0);
gc.addNumericField("Postpone imaging by (min) ", 0 ,0);
gc.showDialog();
if (gc.wasCanceled())
	return;
userExpt = gc.getNextChoice();
global.userPause = gc.getNextBoolean();//Read check box
global.userLUC = gc.getNextBoolean();//Read check box
global.userExp = gc.getNextNumber();
global.delayMin= gc.getNextNumber();
userExpMs = userExp * 1000;
delay = delayMin * 1000 * 60;
if (userLUC == false){
	global.nrChannels = 3;}
if (userLUC == true){
	global.nrChannels = 4;
	}

if (userPause == true){
	gz = new ij.gui.GenericDialog("LUMO Imaging System");
	gz.addNumericField("Delay time (s) : ", 60, 0);
	gz.showDialog();
	if (gz.wasCanceled())
	return;
	userDelay = gz.getNextNumber();
	global.userDelayMs = userDelay * 1000;
	global.flexDelay = 600000 - userDelayMs;
	}

//Quick imaging
if (userExpt == "GFP quick image"){

//Turn off overhead lights
mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set red growth LEDs to off
mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0"); //Set blue growth LEDs to off
mmc.sleep(2000); //wait before entering loop
mmc.setProperty("LUMO", "Gain", "2");//Mid sensitivity mode
mmc.setProperty("LUMO", "PP  1   ENABLED", "No");//Turn off high pixel reduction
mm.scripter().clearMessageWindow();

//Setup save file
saveLocation += userFile;
Datastore store = mm.data().createRAMDatastore();

//Sort out metadata
sb = store.getSummaryMetadata().copyBuilder();
axisOrder = new ArrayList();
axisOrder.add(Coords.C);
axisOrder.add(Coords.T);
sb.axisOrder(axisOrder);
channelNames = new ArrayList();
channelNames.add("460nm");
channelNames.add("400nm");
channelNames.add("Autofluo");
if (userLUC == true){channelNames.add("Luciferase");}
sb.channelNames(channelNames);
coordsB = store.getSummaryMetadata().getIntendedDimensions().copyBuilder();
coordsB.c(nrChannels).t(1);//put in number of frames here, channels can be changed too
sb.intendedDimensions(coordsB.build());
store.setSummaryMetadata(sb.build());
mm.displays().createDisplay(store);

public void refreshGUI();

if (delayMin > 0){
	mm.scripter().message("Imaging delayed by "+delayMin+" min");
}
mmc.sleep(delay);

//Taking 460nm image
mmc.setExposure(userExpMs);
mmc.setProperty("FW", "State", "0");//Moves to 515nm
mmc.deviceBusy("FW"); //Safety call to wait for filterwheel to move
mmc.sleep(1000); //Pause before exposure (currently 1 sec)
mm.scripter().message("Exposure in progress");
mmc.setProperty("Arduino32-DAC/460nm", "Volts", "100");
mmc.sleep(1000); //Pause after turning lights on (currently 1 sec)

//Image capture
image = mm.live().snap(false).get(0);
Coords.CoordsBuilder builder = mm.data().getCoordsBuilder();
builder = builder.time(0).channel(0);
image = image.copyAtCoords(builder.build());
store.putImage(image);
mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish
mm.scripter().message("460nm image acquired");

mmc.setProperty("Arduino32-DAC/460nm", "Volts", "0");
mmc.setProperty("Arduino32-DAC/400nm", "Volts", "100");
mmc.sleep(1000); //Pause before exposure (currently 1 sec)
image = mm.live().snap(false).get(0);
builder = builder.channel(1);
image = image.copyAtCoords(builder.build());
store.putImage(image);
mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish
mm.scripter().message("400nm image acquired");

mmc.setProperty("Arduino32-DAC/400nm", "Volts", "100");
mmc.setProperty("FW", "State", "3");//Moves to 460nm
mmc.deviceBusy("FW"); //Safety call to wait for filterwheel to move
mmc.sleep(1000); //Pause (currently 1sec)
image = mm.live().snap(false).get(0);
builder = builder.channel(2);
image = image.copyAtCoords(builder.build());
store.putImage(image);
mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish
mm.scripter().message("Autofluorescence image (400nm ex/460nm em) acquired");

mmc.setProperty("Arduino32-DAC/400nm", "Volts", "0"); //Turn off imaging LEDs
mmc.setProperty("Arduino32-DAC/460nm", "Volts", "0");

if (userLUC == true){
	mmc.setProperty("LUMO", "Gain", "3");//High sensitivity mode
	mmc.setProperty("LUMO", "PP  1   ENABLED", "Yes");//Turn on high pixel reduction
	mmc.setProperty("FW", "State", "4");
	mmc.deviceBusy("FW"); //Safety call to wait for filterwheel to move
	mmc.setExposure(300000);//Set exposure for luciferase (5 min)
	mm.scripter().message("Dark before luciferase imaging");
	mmc.sleep(30000); //Pause before luciferase exposure (currently 30 s)
	mm.scripter().message("Luciferase imaging in progress");

	image = mm.live().snap(false).get(0);
	builder = builder.channel(3);
	image = image.copyAtCoords(builder.build());
	store.putImage(image);
	}
	mmc.sleep(1000); //Pause after exposures (currently 1 sec)
	mmc.deviceBusy("LUMO"); //Safety call to wait for exposure to finish

//Hardware reset
mmc.sleep(5000);
mmc.setProperty("Arduino32-DAC/460nm", "Volts", "0"); //Turn all lights off, redundant but safe
mmc.setProperty("Arduino32-DAC/400nm", "Volts", "0");
mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0");
mmc.setProperty("Arduino32-DAC/Red", "Volts", "0");
mm.scripter().message("LEDs off after imaging");
mmc.setProperty("FW", "State", "0");//Move filter into 515nm
mmc.deviceBusy("FW"); //Safety call to wait for filterwheel to move
mmc.setExposure(20); // Resets camera exposure (in ms)
mmc.setProperty("LUMO", "Gain", "2");//Mid sensitivity mode
mmc.setProperty("LUMO", "PP  1   ENABLED", "No");//Turn off high pixel reduction
public void refreshGUI();
//Save data
store.save(Datastore.SaveMode.MULTIPAGE_TIFF, saveLocation);
saveLocation += file2;
store.freeze();
mm.scripter().message("Images saved");
return;}//End of Quick image

//LD-LL
if (userExpt == "GFP LD-LL"){
//Set parameters for LD-LL
gg = new ij.gui.GenericDialog("GFP LD-LL");
gg.addNumericField("Daylight Red LED intensity : ", 0, 0);
gg.addNumericField("Daylight Blue LED intensity : ", 0, 0);
gg.addNumericField("Imaging interval during days (h): ", 1, 0);
gg.addNumericField("Number of images (Day) : ", 12, 0);
gg.addNumericField("Night Red LED intensity : ", 0, 0);
gg.addNumericField("Night Blue LED intensity : ", 0, 0);
gg.addNumericField("Imaging interval at night (h): ", 1, 0);
gg.addNumericField("Number of images (Night) : ", 12, 0);
gg.addNumericField("Number of days in LD cycles: ", 1, 0);
gg.addNumericField("Number of hours in constant light: ", 120, 0);
gg.addNumericField("Constant conditions Red LED intensity : ", 0, 0);
gg.addNumericField("Constant conditions Blue LED intensity : ", 0, 0);
gg.addNumericField("Closest previous ZT (h): ", 0, 0);
gg.addNumericField("Pause before first imaging loop (min): ", 0, 0);
//gg.addChoice("Flipper active? ", flip, flip[0]);//flipper inactive
gg.showDialog();
if (gg.wasCanceled())
	return;
global.userTrial = userLUMO;
global.RedVoltsA = gg.getNextNumber();
global.BlueVoltsA = gg.getNextNumber();
global.userTimeA = gg.getNextNumber(); //Time with ColourA on
global.nrFramesA = gg.getNextNumber(); 
global.RedVoltsB = gg.getNextNumber();
global.BlueVoltsB = gg.getNextNumber();
global.userTimeB = gg.getNextNumber(); //Time with ColourB on
global.nrFramesB = gg.getNextNumber(); 
global.repeatLoop = gg.getNextNumber();
global.repeatLoop = repeatLoop - 1;
global.nrFramesC = gg.getNextNumber();//Number of images in constant light
global.RedVoltsC = gg.getNextNumber();
global.BlueVoltsC = gg.getNextNumber();
//userFlipper = gg.getNextChoice();
global.userZt = gg.getNextNumber();
global.pauseA = gg.getNextNumber();

//If numbers are too high, cancel
if (RedVoltsA > 100){
gui.showMessage("Red lights are set too high in day- please change");//Logic gate for exposure
return;}
if (BlueVoltsA > 100){
gui.showMessage("Blue lights are set too high in day- please change");//Logic gate for exposure
return;}

//If numbers are too high, cancel
if (RedVoltsB > 100){
gui.showMessage("Red lights are set too high at night- please change");//Logic gate for exposure
return;}
if (BlueVoltsB > 100){
gui.showMessage("Blue lights are set too high at night- please change");//Logic gate for exposure
return;}

//If numbers are too high, cancel
if (RedVoltsC > 100){
gui.showMessage("Red lights are set too high at night- please change");//Logic gate for exposure
return;}
if (BlueVoltsC > 100){
gui.showMessage("Blue lights are set too high at night- please change");//Logic gate for exposure
return;}

//Record lights used
usedColourA = new String("\n" + "Red: "+ RedVoltsA + "\n" + "Blue: " + BlueVoltsA );
usedColourB = new String("\n" + "Red: "+ RedVoltsB + "\n" + "Blue: " + BlueVoltsB );
usedColourC = new String("\n" + "Red: "+ RedVoltsC + "\n" + "Blue: " + BlueVoltsC );

//Record Expt ID
usedLUMO = new String("LUMOB-" + userTrial);

//convert to integers
global.nrFramesAi = nrFramesA;
global.nrFramesBi = nrFramesB;
global.nrFramesCi = (nrFramesC / userTimeA);
global.repeatLoopi = repeatLoop;
global.pauseAi = pauseA;
global.pauseAims = pauseAi * 60000;

global.dayCal = nrFramesAi * userTimeA;
global.nightCal = nrFramesBi * userTimeB;
global.loopCal = repeatLoop + 1;
String dayCalu = new String ();
String nightCalu = new String ();
String loopCalu = new String ();
String pauseCalu = new String ();
dayCalu += dayCal;
nightCalu += nightCal;
loopCalu += loopCal;
pauseCal = (int) pauseA;
pauseCalu += pauseCal;

//Confirmation text
gh = new ij.gui.GenericDialog("LD-LL Cycles");
gh.addStringField("Day length (Hrs, Confirmation only): ", dayCalu, 4);
gh.addStringField("Night length (Hrs, Confirmation only): ", nightCalu, 4);
gh.addStringField("# of days (Confirmation only): ", loopCalu, 4);
gh.addStringField("First imaging loop in (Mins, Confirmation only): ", pauseCalu, 4);
gh.showDialog();
if (gh.wasCanceled())
	return;

//Time conversion
global.TimeA = userTimeA * 3600000;
global.TimeB= userTimeB * 3600000;
if (userPause == true){
	if (userLUC == true){
global.TimeAm = TimeA  - 454000 - 7000 - 3 * userExpMs;//7.5min + roGFP image capture (3s wait time + 3 images)- no zeros off here
global.TimeBm = TimeB  - 454000 - 7000 - 3 * userExpMs;//7.5min + roGFP image capture (3s wait time + 3 images)- no zeros off here
}
if (userLUC == false){
global.TimeAm = TimeA - 3000 - 3 * userExpMs - userDelayMs;//roGFP image capture (3s wait time + 3 images)- no zeros off here
global.TimeBm = TimeB - 3000 - 3 * userExpMs - userDelayMs;//roGFP image capture (3s wait time + 3 images)
}
}
if (userPause == false){
	if (userLUC == true){
global.TimeAm = TimeA  - 454000 - 7000 - 3 * userExpMs;//7.5min + roGFP image capture (3s wait time + 3 images)- no zeros off here
global.TimeBm = TimeB  - 454000 - 7000- 3 * userExpMs;//7.5min + roGFP image capture (3s wait time + 3 images)- no zeros off here
}
if (userLUC == false){
global.TimeAm = TimeA - 7000 - 3 * userExpMs;//roGFP image capture (3s wait time + 3 images)- no zeros off here
global.TimeBm = TimeB - 7000 - 3 * userExpMs;//+ roGFP image capture (3s wait time + 3 images)
}
}

//First Day
global.firstDiel = nrFramesAi - (userZt / userTimeA);
if (pauseCal == 0){
	global.firstDiel = (int) firstDiel;}
else {global.firstDiel = firstDiel - 1;}
	global.firstNight = nrFramesBi;
	global.firstDay = firstDiel + firstNight;
	print("First diurnal: " + firstDiel + " images");
	print("First night: " + firstNight + " images");
	print("First day: " + firstDay + " images");

logicDiel = dayCal - userZt;//Logic gate for day length
if (logicDiel <= 1){
	mm.scripter().message("Cannot start after ZT11");
	return;}

//Flipper picker- LD-LL loop- INACTIVE
