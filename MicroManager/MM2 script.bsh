//LL with GFP 
if (userExpt == "GFP LL"){
gd = new ij.gui.GenericDialog("Constant Conditions Setup");
gd.addNumericField("Red LED intensity : ", 0, 0);
gd.addNumericField("Blue LED intensity : ", 0, 0);
gd.addNumericField("Number of Minutes : ", 10, 0);
gd.addNumericField("Number of Minutes (light) : ", 10, 0);
gd.addNumericField("Images per minute", 2, 0);
gd.addCheckbox("Advanced_Settings",false);
gd.showDialog();
if (gd.wasCanceled())
	return;
global.RedVolts = gd.getNextNumber();
global.BlueVolts = gd.getNextNumber();
global.userTl = gd.getNextNumber();
global.userBl = gd.getNextNumber();
global.userF = gd.getNextNumber();
userSettings = gd.getNextBoolean();//Read check box
global.usedExpose = 5000;
global.usedDelay = 10000;

//If numbers are too high, cancel
if (RedVolts > 100){
gui.showMessage("Red lights are set too high- please change");//Logic gate for exposure
return;}
if (BlueVolts > 100){
gui.showMessage("Blue lights are set too high- please change");//Logic gate for exposure
return;}

//Record lights used
usedColour = new String("\n" + "Red: "+ RedVolts + "\n" + "Blue: " + BlueVolts);
testColour = new String("\n" + "Red: "+ RedVolts + "\n" + "Blue: " + BlueVolts);

//Record expt ID
global.usedLUMO = new String("LUMOB-" + userLUMO);

//Colour picker
mmc.setProperty("Arduino32-DAC/Red", "Volts", "0"); //Set red growth LEDs to off
mmc.setProperty("Arduino32-DAC/Blue", "Volts", "0"); //Set blue growth LEDs to off

if (userSettings == true){
	ge = new ij.gui.GenericDialog("Advanced Options");
	ge.addNumericField("Delay before imaging", 5, 0);
	ge.addChoice("Units", units, units[0]);
	ge.addNumericField("Exposure Time", 30, 0);
	ge.addChoice("Units", units, units[0]);
	ge.showDialog();
if (ge.wasCanceled())
	return;
global.userDelay = ge.getNextNumber();
global.delayUserUnits = ge.getNextChoice();
global.userExpose = ge.getNextNumber();
global.expUserUnits = ge.getNextChoice();

//Custom exposure and delays

if (delayUserUnits == "min"){
	global.delayUnits = 60000;}
else {delayUnits = 1000;}
if (expUserUnits == "min"){
	global.expUnits = 60000;}
else {expUnits = 1000;}
global.usedDelay = userDelay * delayUnits;
global.usedExpose = userExpose * expUnits;
if (usedDelay <= 99){
	mm.scripter().message("Delay must be greater than 100 ms!");
	return;}
if (usedExpose <= 0){
	mm.scripter().message("Exposure must be greater than 0!");
return;}
}


if (delayMin > 0){
	mm.scripter().message("Imaging delayed by "+delayMin+" min");
}
mmc.sleep(delay);

//Starting timestamp
mm.scripter().clearMessageWindow();
String startText = new String("Expt started at: ");
Calendar cal = Calendar.getInstance();
startText += cal.getTime();
print(startText);

usedExpt = new String("GFP");
global.ExptTime = userTl * userF; 
global.nrFrames = ExptTime;
global.BlFrames = userBl * userF;

//Time conversion
global.TimeA = 60000 / userF; //Image every 60 sec (below- subtracting imaging time) !! 
global.TimeB = 60000 / userF;
if (userPause == true){
	if (userLUC == true){
global.TimeAm = TimeA - 334000 - 6000 - 3* userExpMs;//10min + roGFP image capture- no zeros off here
global.TimeBm = TimeB - 334000 - 6000 - 3* userExpMs;//10min + roGFP second image capture- no zeros off here
}
if (userLUC == false){
global.TimeAm = TimeA - 6000 - 3* userExpMs - userDelayMs;//+ roGFP second image capture- no zeros off here
global.TimeBm = TimeB - 6000 - 3* userExpMs - userDelayMs;//+ roGFP second image capture
}
}
if (userPause == false){
	if (userLUC == true){
global.TimeAm = TimeA - 334000 - 6000 - 3* userExpMs;//10min + roGFP image capture- no zeros off here
global.TimeBm = TimeB - 334000 - 6000 - 3* userExpMs;//10min + roGFP image capture- no zeros off here
}
if (userLUC == false){
global.TimeAm = TimeA - 6000 - 3* userExpMs;//+ roGFP image capture- no zeros off here
global.TimeBm = TimeB - 6000 - 3 * userExpMs;//+ roGFP image capture
}
}

